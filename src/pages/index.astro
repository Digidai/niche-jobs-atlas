---
import { getCollection } from 'astro:content';
import Pips from '../components/Pips.astro';
import Plate from '../components/Plate.astro';
import SpecimenCard from '../components/SpecimenCard.astro';
import { ORDERS, orderOf } from '../data/orders';
import Base from '../layouts/Base.astro';
import { parseEntry } from '../lib/entry';
import { SITE, TREND, pad, url } from '../lib/site';

const jobs = (await getCollection('jobs')).sort((a, b) => a.data.no - b.data.no);
const sourceCount = jobs.reduce((sum, job) => sum + parseEntry(job.body ?? '', job.id).sources.length, 0);

// 封面上压着的三张图版
const cover = [11, 6, 21].map((no) => jobs.find((job) => job.data.no === no)!).filter(Boolean);
---

<Base>
  <section class="hero">
    <div class="hero-title" aria-hidden="true">
      <span class="hero-title-main">小众职业</span>
      <span class="hero-title-sub">图鉴</span>
    </div>

    <div class="hero-body">
      <p class="kicker">A Field Guide to Niche Jobs · {SITE.edition}</p>
      <h1 class="sr-only">{SITE.title}</h1>
      <p class="lede">
        有人上班的第一件事是闻三袋臭气，有人半夜把耳朵贴在一根钢杆上听马路，有人在高压舱里一住就是 28 天。
      </p>
      <p class="hero-text">
        这些工作都是真的，干的人很少，知道的人更少。这本图鉴把它们当成稀有物种来观察：记下栖息地、出没时间、识别特征和天敌，再附一段现场笔记。
      </p>
      <dl class="tally">
        <div><dt>收录</dt><dd>{jobs.length}<small>种</small></dd></div>
        <div><dt>分作</dt><dd>{ORDERS.length}<small>目</small></dd></div>
        <div><dt>引用来源</dt><dd>{sourceCount}<small>条</small></dd></div>
      </dl>
      <div class="hero-actions">
        <button class="btn btn-primary" type="button" data-encounter>
          <span class="btn-dot" aria-hidden="true"></span>
          <span data-encounter-label="随机遇见一种">随机遇见一种</span>
        </button>
        <a class="btn btn-ghost" href={url('/guide/')}>怎么读这本图鉴</a>
      </div>
    </div>

    <div class="hero-plates">
      {
        cover.map((job, i) => (
          <a
            class={`cover-plate cover-plate-${i + 1}`}
            href={url(`/jobs/${job.id}/`)}
            style={`--accent:${orderOf(job.data.order).color}`}
          >
            <Plate no={job.data.no} name={job.data.name} accent={orderOf(job.data.order).color} mode="full" />
            <span class="cover-caption">
              <b>No. {pad(job.data.no)}</b> {job.data.name}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="toolbar" aria-label="检索">
    <nav class="order-nav" aria-label="按目浏览">
      {
        ORDERS.map((order) => (
          <a href={`#${order.slug}`} style={`--accent:${order.color}`}>
            <i aria-hidden="true" />
            {order.key}
          </a>
        ))
      }
    </nav>
    <label class="search">
      <span class="sr-only">在图鉴里查找</span>
      <input type="search" placeholder="查一种职业，比如“潜水”" autocomplete="off" data-search />
    </label>
    <p class="legend">
      <span><Pips value={5} label="稀有度示例" /> 稀有度：点越多，干这行的人越少</span>
      <span>{TREND.up.glyph} {TREND.flat.glyph} {TREND.down.glyph} 种群趋势</span>
    </p>
  </section>

  <p class="no-result" data-no-result hidden>
    图鉴里还没有这种职业。可以<a href={`${SITE.repo}/issues/new/choose`} rel="noopener">提名它</a>，或者
    <button type="button" class="link-btn" data-clear-search>清空重查</button>。
  </p>

  {
    ORDERS.map((order) => {
      const members = jobs.filter((job) => job.data.order === order.key);
      return (
        <section class="order" id={order.slug} style={`--accent:${order.color}`} data-order>
          <header class="order-head">
            <p class="order-numeral" aria-hidden="true">{order.numeral}</p>
            <div>
              <h2>
                {order.key}
                <span lang="la">{order.latin}</span>
              </h2>
              <p class="order-tagline">{order.tagline}</p>
            </div>
            <p class="order-blurb">{order.blurb}</p>
          </header>
          <div class="grid">
            {members.map((job) => <SpecimenCard job={job} />)}
          </div>
        </section>
      );
    })
  }

  <section class="closing">
    <div class="closing-card">
      <p class="kicker">附录</p>
      <h2>传说中的神仙工作，是真的吗</h2>
      <p>企鹅扶正员、酒店试睡员、年薪百万的熊猫饲养员。我们查了 7 个流传很广的“神仙职业”，没有一个是轻松高薪的长期工作。</p>
      <a class="btn btn-ghost" href={url('/appendix/')}>去看伪物种辨析</a>
    </div>
    <div class="closing-card">
      <p class="kicker">开源</p>
      <h2>你身边有没有稀有物种</h2>
      <p>图鉴的每个条目都是一个 Markdown 文件。你做着一份少有人知的工作，或者认识这样的人，欢迎补一条，也欢迎纠错。</p>
      <a class="btn btn-ghost" href={`${SITE.repo}/blob/main/CONTRIBUTING.md`} rel="noopener">看投稿办法</a>
    </div>
  </section>

  <script is:inline>
    // 首页检索：按名字、别称、英文名和一句话简介过滤卡片。
    const input = document.querySelector('[data-search]');
    const cards = [...document.querySelectorAll('[data-card]')];
    const orders = [...document.querySelectorAll('[data-order]')];
    const empty = document.querySelector('[data-no-result]');
    const apply = () => {
      const query = input.value.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const hit = !query || card.dataset.keywords.includes(query);
        card.hidden = !hit;
        if (hit) shown += 1;
      }
      for (const order of orders) {
        order.hidden = !order.querySelector('[data-card]:not([hidden])');
      }
      empty.hidden = shown > 0;
    };
    input.addEventListener('input', apply);
    document.querySelector('[data-clear-search]').addEventListener('click', () => {
      input.value = '';
      apply();
      input.focus();
    });
  </script>
</Base>
